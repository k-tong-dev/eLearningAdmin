{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "character": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::charactor.charactor",
      "inversedBy": "users"
    },
    "badges": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::badge.badge"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "providerId": {
      "type": "string"
    },
    "interested": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::interested.interested"
    },
    "learning_goals": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::learning-goal.learning-goal"
    },
    "prefer_to_learns": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::prefer-to-learn.prefer-to-learn"
    },
    "bio": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "supabaseId": {
      "type": "string"
    },
    "skills": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::skill.skill"
    },
    "monetization": {
      "type": "enumeration",
      "required": true,
      "default": "locked",
      "enum": [
        "locked",
        "unlock"
      ]
    },
    "notice_new_enrollment": {
      "type": "boolean",
      "default": false
    },
    "notice_course_reviewer": {
      "type": "boolean",
      "default": false
    },
    "notice_payment": {
      "type": "boolean",
      "default": false
    },
    "notice_weekly_analysis": {
      "type": "boolean",
      "default": false
    },
    "facebook": {
      "type": "string"
    },
    "linkin": {
      "type": "string"
    },
    "twister": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "github": {
      "type": "string"
    },
    "instructor_limit": {
      "type": "integer",
      "default": 1
    },
    "instructor_count": {
      "type": "integer",
      "default": 0
    },
    "banking_info": {
      "type": "blocks"
    },
    "instructors": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::instructor.instructor",
      "mappedBy": "user"
    },
    "purchase_transactions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::purchase-transaction.purchase-transaction",
      "mappedBy": "user"
    },
    "user_subscriptions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-subscription.user-subscription",
      "mappedBy": "user"
    },
    "payment_methods": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payment-method.payment-method",
      "mappedBy": "user"
    },
    "following": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::instructor.instructor",
      "inversedBy": "followers"
    },
    "friend_limit": {
      "type": "integer",
      "default": 1000
    },
    "instructor_group_limit": {
      "type": "integer",
      "default": 20
    },
    "user_group_limit": {
      "type": "integer"
    },
    "user_groups": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-group-group.user-group-group",
      "mappedBy": "owner"
    },
    "user_group_member_limit": {
      "type": "integer",
      "default": 120
    },
    "instructor_group_member_limit": {
      "type": "integer",
      "default": 60
    },
    "company": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::company.company",
      "inversedBy": "users"
    },
    "certificates": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::certificate-program.certificate-program",
      "mappedBy": "candidates"
    },
    "course_enrollments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-enrollment.course-enrollment",
      "mappedBy": "user"
    },
    "content_progresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::content-progress.content-progress",
      "mappedBy": "user"
    }
  }
}
