      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "course_material": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-material.course-material",
      "inversedBy": "course_contents"
    },
    "course_course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-course.course-course",
      "inversedBy": "course_contents"
    },
    "is_paid": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "price": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": 0
    },
    "currency": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::currency.currency"
    },
    "preview_duration": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "purchase_count": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": 0
    },
    "revenue_generated": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": 0
    }
  }
}
