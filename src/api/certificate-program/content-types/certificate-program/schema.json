{
  "kind": "collectionType",
  "collectionName": "certificate_programs",
  "info": {
    "singularName": "certificate-program",
    "pluralName": "certificate-programs",
    "displayName": "Certificate Program"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "owner": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "candidates": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "inversedBy": "certificates"
    },
    "course_quizs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-quiz.course-quiz",
      "mappedBy": "certificate"
    },
    "course_content": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-content.course-content",
      "inversedBy": "certificates"
    },
    "auto_issue": {
      "type": "boolean",
      "default": true
    },
    "min_score_to_pass": {
      "type": "decimal",
      "default": 0.7
    },
    "valid_until": {
      "type": "datetime"
    },
    "company": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::company.company",
      "inversedBy": "certificates"
    },
    "message": {
      "type": "string"
    },
    "issue_criterial": {
      "type": "string"
    },
    "theme": {
      "type": "enumeration",
      "default": "Aurora",
      "enum": [
        "Aurora",
        "Minimal",
        "Premium",
        "Classic"
      ]
    },
    "signature_name": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "include_seal": {
      "type": "boolean",
      "default": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "quiz_attempts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quiz-attempt.quiz-attempt",
      "mappedBy": "certificate_program"
    },
    "quiz_attempt": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::quiz-attempt.quiz-attempt",
      "inversedBy": "issued_certificate"
    },
    "certificate_issuances": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::certificate-issuance.certificate-issuance",
      "mappedBy": "certificate_program"
    },
    "color": {
      "type": "string"
    }
  }
}
