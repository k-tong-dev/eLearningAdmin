{
  "kind": "collectionType",
  "collectionName": "report_issues",
  "info": {
    "singularName": "report-issue",
    "pluralName": "report-issues",
    "displayName": "Report Problem"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "richtext",
      "maxLength": 500
    },
    "internal_noted": {
      "type": "richtext"
    },
    "state": {
      "type": "enumeration",
      "default": "draft",
      "enum": [
        "draft",
        "checking",
        "done"
      ]
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Issue",
        "Article",
        "Content"
      ]
    },
    "report_content_types": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::report-content-type.report-content-type",
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "type"
            },
            "Issue"
          ]
        }
      }
    },
    "url": {
      "type": "string"
    }
  }
}
