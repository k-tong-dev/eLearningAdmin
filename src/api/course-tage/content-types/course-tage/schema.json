{
  "kind": "collectionType",
  "collectionName": "course_tages",
  "info": {
    "singularName": "course-tage",
    "pluralName": "course-tages",
    "displayName": "Course Tage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "unique": true
    },
    "icon": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "course_count": {
      "type": "integer",
      "default": 0
    },
    "popularity_score": {
      "type": "decimal",
      "default": 0
    },
    "related_tags": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-tage.course-tage"
    }
  }
}
