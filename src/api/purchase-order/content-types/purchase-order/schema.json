{
  "kind": "collectionType",
  "collectionName": "purchase_orders",
  "info": {
    "singularName": "purchase-order",
    "pluralName": "purchase-orders",
    "displayName": "Sale Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "order_number": {
      "type": "uid",
      "required": true,
      "regex": "ORD-"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "sale_orders"
    },
    "purchase_status": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "refunded",
        "cancelled"
      ]
    },
    "subtotal": {
      "type": "decimal"
    },
    "tax": {
      "type": "decimal"
    },
    "total": {
      "type": "decimal"
    },
    "currency": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::currency.currency"
    },
    "payment_method": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::payment-method.payment-method"
    },
    "payment_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ]
    },
    "payment_intent_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "completed_at": {
      "type": "datetime"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "sale_order"
    },
    "transaction_logs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::transaction-log.transaction-log",
      "mappedBy": "sale_order"
    }
  }
}
