{
  "kind": "collectionType",
  "collectionName": "instructor_invitations",
  "info": {
    "singularName": "instructor-invitation",
    "pluralName": "instructor-invitations",
    "displayName": "Instructor Invitation"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "from_instructor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::instructor.instructor",
      "required": true
    },
    "to_instructor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::instructor.instructor",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "accepted", "rejected", "cancelled"],
      "default": "pending",
      "required": true
    },
    "message": {
      "type": "text"
    },
    "invited_at": {
      "type": "datetime"
    },
    "responded_at": {
      "type": "datetime"
    },
    "course_context": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-course.course-course"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  }
}

