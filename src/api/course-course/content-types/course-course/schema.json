{
  "kind": "collectionType",
  "collectionName": "course_courses",
  "info": {
    "singularName": "course-course",
    "pluralName": "course-courses",
    "displayName": "Course Course"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "course_courses"
    },
    "course_status": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "draft",
      "enum": [
        "cancel",
        "draft",
        "published"
      ]
    },
    "company": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::company.company"
    },
    "instructors": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::instructor.instructor"
    },
    "Price": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": 0
    },
    "course_level": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::course-level.course-level"
    },
    "duration_minutes": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": 0
    },
    "course_categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-category.course-category"
    },
    "course_tages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-tage.course-tage"
    },
    "currency": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::currency.currency"
    },
    "is_paid": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "preview_available": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "purchase_count": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": 0
    },
    "revenue_generated": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": 0
    },
    "purchase_transactions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::purchase-transaction.purchase-transaction",
      "mappedBy": "course_course"
    },
    "course_preview": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-preview.course-preview",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "preview_available"
            },
            true
          ]
        }
      },
      "inversedBy": "course_courses"
    },
    "course_badges": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-badge.course-badge"
    },
    "relevant_skills": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::skill.skill"
    },
    "discount_type": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "is_paid"
            },
            true
          ]
        }
      },
      "required": false,
      "enum": [
        "percentage",
        "fix_price"
      ]
    },
    "discount_percentage": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "discount_type"
            },
            "percentage"
          ]
        }
      },
      "default": 0
    },
    "discount_fix_price": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "discount_type"
            },
            "fix_price"
          ]
        }
      },
      "default": 0
    },
    "course_materials": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-material.course-material",
      "mappedBy": "course_course"
    },
    "active": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": true
    },
    "enrollment_count": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": 0
    },
    "can_edit_after_publish": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "enrollments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-enrollment.course-enrollment",
      "mappedBy": "course_course"
    },
    "course_reviewers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-reviewer.course-reviewer",
      "mappedBy": "course_course"
    },
    "card_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::card-item.card-item",
      "mappedBy": "course"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "course"
    }
  }
}
