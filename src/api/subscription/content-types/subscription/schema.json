{
  "kind": "collectionType",
  "collectionName": "subscriptions",
  "info": {
    "singularName": "subscription",
    "pluralName": "subscriptions",
    "displayName": "Subscription"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": false,
      "unique": false
    },
    "group_plan": {
      "type": "enumeration",
      "required": true,
      "default": "base",
      "enum": [
        "base",
        "friend_extend"
      ]
    },
    "type": {
      "type": "enumeration",
      "default": "Free",
      "enum": [
        "Free",
        "Basic",
        "Pro",
        "Enterpris"
      ]
    },
    "sequnce": {
      "type": "integer",
      "default": 1,
      "unique": true
    },
    "price": {
      "type": "decimal",
      "conditions": {
        "visible": {
          "!=": [
            {
              "var": "type"
            },
            "Free"
          ]
        }
      },
      "default": 0
    },
    "subscription_tax": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::subscription-tax.subscription-tax"
    },
    "description": {
      "type": "richtext"
    },
    "subscription_benefits": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::subscription-benefit.subscription-benefit"
    },
    "currency": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::currency.currency"
    },
    "is_popular": {
      "type": "boolean",
      "default": false
    },
    "amount_instructor": {
      "type": "integer",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "group_plan"
            },
            "base"
          ]
        }
      },
      "required": false,
      "default": 0
    },
    "amount_friend_allowed": {
      "type": "integer",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "group_plan"
            },
            "friend_extend"
          ]
        }
      },
      "default": 1000
    },
    "amount_instructor_group_allowed": {
      "type": "integer",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "group_plan"
            },
            "base"
          ]
        }
      },
      "default": 20
    },
    "amount_group_allowed": {
      "type": "integer",
      "default": 50
    }
  }
}
