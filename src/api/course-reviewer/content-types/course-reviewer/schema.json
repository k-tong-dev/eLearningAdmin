{
  "kind": "collectionType",
  "collectionName": "course_reviewers",
  "info": {
    "singularName": "course-reviewer",
    "pluralName": "course-reviewers",
    "displayName": "Course Reviewer"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "course_course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-course.course-course",
      "inversedBy": "course_reviewers"
    },
    "description": {
      "type": "string"
    },
    "rating_stars": {
      "type": "integer",
      "default": 0,
      "max": 5
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
